{
  "openapi": "3.0.0",
  "info": {
    "title": "TCG Deck Builder API",
    "version": "1.0.0",
    "description": "API for COP 4331 Deck Builder & Probability Calculator"
  },
  "servers": [
    {
      "url": "http://talavital.com/api",
      "description": "Live Production Server"
    }
  ],
  "paths": {
    "/cards/search": {
      "get": {
        "summary": "Search cards by partial name match",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Successful search" }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Check API health status",
        "responses": {
          "200": { "description": "API is online" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "TA Demo" },
                  "email": { "type": "string", "example": "demo@ucf.edu" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Validation error or user exists" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login an existing user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "demo@ucf.edu" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful login returns JWT token" },
          "401": { "description": "Invalid credentials" }
        }
      }
    }
  }
}
